import React, { useEffect, useMemo, useState } from "react"; import { motion } from "framer-motion"; import { ShoppingCart, MapPin, Bike, IndianRupee, Search, Trash2, Minus, Plus, CheckCircle2 } from "lucide-react"; import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"; import { Button } from "@/components/ui/button"; import { Input } from "@/components/ui/input"; import { Badge } from "@/components/ui/badge";

/**

Dolfin Bazar – Maharajganj Hyperlocal E‑commerce MVP (ENGLISH ONLY)

Single-file React app (no backend):

Catalog by category


Cart (add/remove/qty)


Checkout form (Name/Phone/Address/Landmark)


Payment choice: COD / UPI on Delivery


Free delivery on ₹499+


Order submits via pre-filled email (mailto) to dolfinbazar@gmail.com (zero-cost fallback)


Deploy free on Vercel/Netlify. Later you can connect EmailJS/Google Forms/Supabase. */


const SHOP = { name: "Dolfin Bazar", city: "Maharajganj", deliveryRadiusKm: 12, // district-wide coverage (adjust as needed) freeDeliveryMin: 499, deliveryFeeFlat: 20, cod: true, upiAccepted: true, orderEmail: "dolfinbazar@gmail.com", tagline: "Local bazaar, fast delivery", };

const CATEGORIES = [ { id: "garments", label: "Garments" }, { id: "electronics", label: "Electronic & Phones" }, { id: "grocery", label: "Grocery Store" }, { id: "home_accessories", label: "Home Accessories" }, { id: "home_making", label: "Home Making Accessories" }, ];

// Sample products (edit freely) const PRODUCTS = [ // Garments { id: "g1", title: "Men's Cotton T‑Shirt (Plain)", price: 199, category: "garments", image: "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800", stock: 25 }, { id: "g2", title: "Women's Kurti (Casual)", price: 449, category: "garments", image: "https://images.unsplash.com/photo-1520975916090-3105956dac38?w=800", stock: 12 }, { id: "g3", title: "Kids Jeans", price: 399, category: "garments", image: "https://images.unsplash.com/photo-1510678960173-b83c2b83f0df?w=800", stock: 18 },

// Electronic & Phones { id: "e1", title: "9W LED Bulb", price: 79, category: "electronics", image: "https://images.unsplash.com/photo-1517048676732-d65bc937f952?w=800", stock: 50 }, { id: "e2", title: "Type‑C Charging Cable (1m)", price: 149, category: "electronics", image: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=800", stock: 40 }, { id: "e3", title: "Bluetooth Earbuds (Basic)", price: 799, category: "electronics", image: "https://images.unsplash.com/photo-1585386959984-a4155223168f?w=800", stock: 20 },

// Grocery Store { id: "gr1", title: "Aashirvaad Atta 5kg", price: 289, category: "grocery", image: "https://images.unsplash.com/photo-1604335399105-a0d7b6cab30b?w=800", stock: 20 }, { id: "gr2", title: "Toor Dal 1kg", price: 139, category: "grocery", image: "https://images.unsplash.com/photo-1604908554027-779f0a54d06a?w=800", stock: 35 }, { id: "gr3", title: "Sunflower Oil 1L", price: 155, category: "grocery", image: "https://images.unsplash.com/photo-1514986888952-8cd320577b68?w=800", stock: 30 },

// Home Accessories { id: "ha1", title: "LED Table Lamp", price: 599, category: "home_accessories", image: "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=800", stock: 14 }, { id: "ha2", title: "Wall Clock (Modern)", price: 349, category: "home_accessories", image: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=800", stock: 22 }, { id: "ha3", title: "Cushion Cover Set (2)", price: 249, category: "home_accessories", image: "https://images.unsplash.com/photo-1493666438817-866a91353ca9?w=800", stock: 28 },

// Home Making Accessories (Kitchen/Cleaning/Storage) { id: "hm1", title: "Stainless Steel Kadhai (24cm)", price: 699, category: "home_making", image: "https://images.unsplash.com/photo-1629453460352-1454f0f0fe8f?w=800", stock: 10 }, { id: "hm2", title: "Airtight Storage Container (1.5L)", price: 129, category: "home_making", image: "https://images.unsplash.com/photo-1586201375754-1421e0aa2fda?w=800", stock: 40 }, { id: "hm3", title: "Microfiber Cleaning Cloth (Pack of 3)", price: 99, category: "home_making", image: "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800", stock: 60 }, ];

function currency(n){ return ₹${n.toFixed(0)}; }

// Simple dolphin + bazaar text logo (clean, modern) function Logo(){ return ( <div className="flex items-center gap-2 select-none"> <svg width="28" height="28" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" className="drop-shadow-sm"> <path d="M10 38c8-16 26-22 44-16-6 0-10 4-12 8 4 2 8 6 8 10-8-4-18-2-26 2-6 3-10 2-14-4 4 1 6 1 10 0-4-2-6-4-10-6z" fill="#0ea5e9"/> <circle cx="46" cy="24" r="2" fill="#082f49"/> </svg> <div className="leading-tight"> <div className="text-xl font-extrabold tracking-tight">Dolfin <span className="text-sky-600">Bazar</span></div> <div className="text-xs text-slate-500">Maharajganj • fast & local</div> </div> </div> ); }

export default function DolfinBazarApp(){ const [search, setSearch] = useState(""); const [category, setCategory] = useState("all"); const [area, setArea] = useState("");

const [cart, setCart] = useState(() => { try { return JSON.parse(localStorage.getItem("db_cart")||"{}"); } catch { return {}; } }); useEffect(()=>{ localStorage.setItem("db_cart", JSON.stringify(cart)); }, [cart]);

const filtered = useMemo(() => { return PRODUCTS.filter((p)=> (category === "all" || p.category === category) && (search.trim()==="" || p.title.toLowerCase().includes(search.toLowerCase())) ); }, [search, category]);

const cartItems = Object.entries(cart).map(([id, qty])=>{ const p = PRODUCTS.find(x=>x.id===id); return p ? { ...p, qty } : null; }).filter(Boolean);

const subtotal = cartItems.reduce((s, it)=> s + it.price * it.qty, 0); const deliveryFee = subtotal >= SHOP.freeDeliveryMin ? 0 : (cartItems.length? SHOP.deliveryFeeFlat : 0); const total = subtotal + deliveryFee;

function addToCart(id, qty=1){ setCart((c)=> ({...c, [id]: Math.max(1, (c[id]||0)+qty)})); } function setQty(id, qty){ setCart((c)=> ({...c, [id]: Math.max(1, qty)})); } function removeFromCart(id){ setCart((c)=> { const n={...c}; delete n[id]; return n; }); } function clearCart(){ setCart({}); }

const [orderPlaced, setOrderPlaced] = useState(false);

function placeOrder(e){ e.preventDefault(); const fd = new FormData(e.currentTarget); const name = fd.get("name"); const phone = fd.get("phone"); const address = fd.get("address"); const landmark = fd.get("landmark"); const pay = fd.get("payment");

if(!cartItems.length) return alert("Cart is empty");

const lines = [
  `New Order – ${SHOP.name} (${SHOP.city})`,
  "",
  `Customer: ${name}`,
  `Phone: ${phone}`,
  `Address: ${address}`,
  `Landmark: ${landmark}`,
  `Payment: ${pay}`,
  "",
  "Items:",
  ...cartItems.map(it=>`• ${it.title} x ${it.qty} = ₹${it.price*it.qty}`),
  "",
  `Subtotal: ₹${subtotal}`,
  `Delivery: ${deliveryFee===0?"Free":`₹${deliveryFee}`}`,
  `Total: ₹${total}`,
  "",
  `Area/Note: ${area||"(not provided)"}`,
].join("%0D%0A");

const subject = encodeURIComponent(`Order – ${name} – ₹${total}`);
const body = lines; // already URI encoded line breaks

// Zero-cost fallback: opens user's mail client with pre-filled order
window.location.href = `mailto:${SHOP.orderEmail}?subject=${subject}&body=${body}`;

// Show success UI
setOrderPlaced(true);
clearCart();

}

return ( <div className="min-h-screen bg-gradient-to-b from-white to-slate-50 text-slate-800"> {/* Header */} <header className="sticky top-0 z-20 bg-white/90 backdrop-blur border-b"> <div className="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between"> <Logo /> <div className="hidden md:flex items-center gap-4 text-sm"> <MapPin className="w-4 h-4" /> <span>{SHOP.city} • {SHOP.deliveryRadiusKm}km</span> <Bike className="w-4 h-4 ml-3" /> <span>Same-day delivery</span> <Badge variant="secondary" className="ml-3">Free delivery on ₹{SHOP.freeDeliveryMin}+</Badge> </div> <CartButton count={cartItems.reduce((s,it)=>s+it.qty,0)} /> </div> </header>

{/* Hero/Search */}
  <section className="max-w-6xl mx-auto px-4 py-6">
    <motion.div initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} className="rounded-2xl p-5 bg-white shadow-sm border">
      <div className="flex flex-col md:flex-row items-center md:items-end gap-3">
        <div className="flex-1">
          <h2 className="text-2xl md:text-3xl font-bold">{SHOP.tagline}</h2>
          <p className="mt-1 text-slate-600">{SHOP.city} • Free on ₹{SHOP.freeDeliveryMin}+ • {SHOP.cod?"COD":""}{SHOP.upiAccepted?" • UPI on delivery":""}</p>
        </div>
        <div className="flex items-center gap-2 w-full md:w-auto">
          <div className="relative w-full md:w-80">
            <Search className="w-4 h-4 absolute left-2 top-1/2 -translate-y-1/2" />
            <Input value={search} onChange={(e)=>setSearch(e.target.value)} placeholder="Search products..." className="pl-8" />
          </div>
          <select value={category} onChange={(e)=>setCategory(e.target.value)} className="border rounded-2xl px-3 py-2 bg-white">
            <option value="all">All</option>
            {CATEGORIES.map(c => <option key={c.id} value={c.id}>{c.label}</option>)}
          </select>
        </div>
      </div>
      <div className="mt-3 flex items-center gap-2">
        <Input value={area} onChange={(e)=>setArea(e.target.value)} placeholder="Your area / landmark for delivery" className="w-full md:w-96" />
      </div>
    </motion.div>
  </section>

  {/* Grid */}
  <main className="max-w-6xl mx-auto px-4 pb-24 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {filtered.map((p) => (
      <motion.div key={p.id} initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }}>
        <Card className="overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition">
          <img src={p.image} alt={p.title} className="w-full h-44 object-cover" />
          <CardHeader>
            <CardTitle className="text-base leading-tight line-clamp-2">{p.title}</CardTitle>
          </CardHeader>
          <CardContent className="space-y-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-1"><IndianRupee className="w-4 h-4" /><span className="font-semibold text-lg">{p.price}</span></div>
              <Badge>{CATEGORIES.find(c=>c.id===p.category)?.label}</Badge>
            </div>
            <div className="text-xs text-slate-600">{p.stock} in stock</div>
            <div className="flex items-center gap-2">
              <Button className="rounded-2xl" onClick={()=>addToCart(p.id, 1)}>
                <ShoppingCart className="w-4 h-4 mr-2" /> Add to Cart
              </Button>
            </div>
          </CardContent>
        </Card>
      </motion.div>
    ))}
  </main>

  {/* Checkout Drawer */}
  <CartDrawer cartItems={cartItems} subtotal={subtotal} deliveryFee={deliveryFee} total={total} setQty={setQty} removeFromCart={removeFromCart} clearCart={clearCart} />

  {/* Checkout Section */}
  <section className="fixed bottom-0 left-0 right-0 bg-white border-t">
    <div className="max-w-6xl mx-auto px-4 py-3 flex flex-col md:flex-row md:items-center gap-3 justify-between">
      <div className="text-sm">
        <span className="font-semibold">Cart:</span> {cartItems.reduce((s,it)=>s+it.qty,0)} items • Subtotal: {currency(subtotal)} • Delivery: {deliveryFee?currency(deliveryFee):"Free"} • Total: <span className="font-bold">{currency(total)}</span>
      </div>
      <form onSubmit={placeOrder} className="grid grid-cols-2 md:grid-cols-6 gap-2 w-full md:w-auto">
        <Input name="name" required placeholder="Full Name" className="col-span-2 md:col-span-2"/>
        <Input name="phone" required placeholder="Phone Number" pattern="[0-9]{10}" title="10-digit phone" className="col-span-2 md:col-span-1"/>
        <Input name="address" required placeholder="Address" className="col-span-2 md:col-span-2"/>
        <Input name="landmark" placeholder="Landmark" className="col-span-2 md:col-span-1"/>
        <div className="col-span-2 md:col-span-2 flex items-center gap-3 text-sm">
          <label className="flex items-center gap-1"><input type="radio" name="payment" value="COD" defaultChecked/> COD</label>
          <label className="flex items-center gap-1"><input type="radio" name="payment" value="UPI"/> UPI on Delivery</label>
        </div>
        <Button disabled={!cartItems.length} className="col-span-2 md:col-span-1 rounded-2xl">Checkout</Button>
      </form>
    </div>
  </section>

  {orderPlaced && (
    <div className="fixed inset-x-0 bottom-20 flex justify-center">
      <div className="bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-2xl px-4 py-3 shadow-sm flex items-center gap-2">
        <CheckCircle2 className="w-5 h-5"/> Order placed! We will contact you shortly.
      </div>
    </div>
  )}

  {/* Footer */}
  <footer className="bg-white border-t mt-24">
    <div className="max-w-6xl mx-auto px-4 py-6 text-sm text-slate-600 flex flex-col md:flex-row gap-2 md:gap-6 justify-between">
      <div>
        <div className="font-semibold">{SHOP.name}</div>
        <div>{SHOP.city} • {SHOP.deliveryRadiusKm}km • Same-day delivery</div>
      </div>
      <div className="opacity-80">
        <div>Payments: {SHOP.cod ? "Cash on Delivery" : "Prepaid only"}{SHOP.upiAccepted ? " • UPI accepted on delivery" : ""}</div>
        <div>Free on {currency(SHOP.freeDeliveryMin)} • Delivery fee {currency(SHOP.deliveryFeeFlat)} below threshold</div>
        <div>© {new Date().getFullYear()} {SHOP.name}. All rights reserved.</div>
      </div>
    </div>
  </footer>
</div>

); }

function CartButton({count}){ return ( <div className="relative"> <Button variant="outline" className="rounded-2xl"> <ShoppingCart className="w-4 h-4 mr-2"/> Cart {count>0 && <span className="ml-2 text-xs bg-slate-900 text-white rounded-full px-2 py-0.5">{count}</span>} </Button> </div> ); }

function Qty({value, onChange}){ return ( <div className="inline-flex items-center border rounded-xl"> <button type="button" className="px-2 py-1" onClick={()=>onChange(Math.max(1, value-1))}><Minus className="w-4 h-4"/></button> <input className="w-10 text-center outline-none" value={value} onChange={(e)=>onChange(Math.max(1, Number(e.target.value)||1))} /> <button type="button" className="px-2 py-1" onClick={()=>onChange(value+1)}><Plus className="w-4 h-4"/></button> </div> ); }

function CartDrawer({ cartItems, subtotal, deliveryFee, total, setQty, removeFromCart, clearCart }){ return ( <aside className="fixed right-3 bottom-20 w-[320px] max-h-[60vh] overflow-auto bg-white border shadow-xl rounded-2xl p-3 hidden md:block"> <div className="flex items-center justify-between mb-2"> <div className="font-semibold">Cart</div> <Button variant="ghost" className="text-xs" onClick={clearCart}>Clear</Button> </div> {cartItems.length===0 ? ( <div className="text-sm text-slate-500">Your cart is empty.</div> ) : ( <div className="space-y-3"> {cartItems.map(it=> ( <div key={it.id} className="flex gap-2 items-center"> <img src={it.image} alt={it.title} className="w-12 h-12 object-cover rounded"/> <div className="flex-1"> <div className="text-sm font-medium leading-tight line-clamp-2">{it.title}</div> <div className="text-xs text-slate-600">{currency(it.price)}</div> <div className="mt-1"><Qty value={it.qty} onChange={(v)=>setQty(it.id, v)} /></div> </div> <div className="text-right"> <div className="text-sm font-semibold">{currency(it.price*it.qty)}</div> <button className="text-slate-400 hover:text-red-600" onClick={()=>removeFromCart(it.id)}> <Trash2 className="w-4 h-4"/> </button> </div> </div> ))}

<div className="border-t pt-2 text-sm">
        <div className="flex justify-between"><span>Subtotal</span><span>{currency(subtotal)}</span></div>
        <div className="flex justify-between"><span>Delivery</span><span>{deliveryFee?currency(deliveryFee):"Free"}</span></div>
        <div className="flex justify-between font-semibold"><span>Total</span><span>{currency(total)}</span></div>
      </div>
    </div>
  )}
</aside>

); }

